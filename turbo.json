{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/apps/*/src/components/**"
      ],
      "outputs": ["storybook-static/**"]
    },
    "test:storybook": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/apps/*/src/components/**"
      ]
    }
  }
}
