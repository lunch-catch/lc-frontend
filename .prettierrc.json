{
  "$schema": "https://json.schemastore.org/prettierrc",

  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",

  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",

  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": false
}
